# Application
APP_ENV=development
APP_SECRET_KEY=replace-this-local-secret
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (development only)
POSTGRES_DB=infravision
POSTGRES_USER=infravision
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql+psycopg://infravision:change-me-local@postgres:5432/infravision

# NetBox - read-only integration account/token
NETBOX_URL=
NETBOX_TOKEN=

# Zabbix - read-only API token for the FastAPI integration
# Use the frontend API base URL, e.g. https://zabbix.example.com/zabbix
ZABBIX_URL=
ZABBIX_TOKEN=

# Grafana Zabbix data source - separate endpoint for the Grafana container
# Must include api_jsonrpc.php, e.g. http://zabbix:8080/api_jsonrpc.php
ZABBIX_GRAFANA_URL=
ZABBIX_GRAFANA_TOKEN=

# Frontend
VITE_API_URL=http://localhost:8000

# Grafana (development only)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local
