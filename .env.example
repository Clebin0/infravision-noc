# Application
APP_ENV=development
APP_SECRET_KEY=replace-this-local-secret
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (development only)
POSTGRES_DB=infravision
POSTGRES_USER=infravision
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql+psycopg://infravision:change-me-local@postgres:5432/infravision

# Frontend
VITE_API_URL=http://localhost:8000

# Grafana (development only)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local
